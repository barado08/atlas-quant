{
  "name": "ATLAS QUANT — Online Research Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "ATLAS QUANT Streamlit",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postAttachCommand": "echo 'Run: streamlit run app.py --server.address 0.0.0.0 --server.port 8501'",
  "remoteUser": "vscode"
}